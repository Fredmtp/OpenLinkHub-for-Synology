# Monitoring secrets (notifications, command page, Hue plug).  /  Secrets de la surveillance.
# Copy to /volume1/openlinkhub/secrets.env on the NAS, mode 600, owner root.
# À copier sur le NAS en /volume1/openlinkhub/secrets.env, droits 600, propriétaire root.
# NEVER commit it, mail it or paste it in a chat.  /  Ne jamais le mettre dans Git, ni le coller dans une conversation.

# ntfy (push notifications): secret topic name, long and unguessable (20+ characters)
# ntfy (notifications sur le téléphone): nom du canal secret (20 caractères au moins)
NTFY_TOPIC=
# ntfy: access token, only if you have an account (optional)  /  jeton d'accès (facultatif)
NTFY_TOKEN=
# ntfy: server (optional, https://ntfy.sh by default)  /  serveur (facultatif)
NTFY_SERVER=

# Email through Microsoft Graph (optional)  /  Courriel via Microsoft Graph (facultatif)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# sender: a mailbox allowed to send  /  expéditeur: une boîte autorisée à envoyer
MAIL_FROM=
# recipients, comma-separated  /  destinataires, séparés par des virgules
MAIL_TO=

# Command page (maintenance, silence, beep test): password, 8+ characters
# Page de commandes (maintenance, silence, essai des bips): mot de passe de 8 caractères au moins
CONTROL_PASSWORD=

# Philips Hue plug for the fans (optional): bridge address and access key.
# The key is created with dist/hue-lister.ps1 (press the bridge button); never paste it anywhere else.
# Prise Philips Hue des ventilateurs (facultatif): adresse du pont et clé d'accès (créée par dist/hue-lister.ps1).
HUE_BRIDGE=
HUE_KEY=

# AI analysis of alerts (optional): Anthropic API key and model. Without a key, alerts use a standard text.
# Analyse des alertes par une IA (facultatif): clé d'API Anthropic et modèle. Sans clé, texte standard.
ANTHROPIC_API_KEY=
AI_MODEL=
